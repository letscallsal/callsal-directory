---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import BrandPill from '../components/BrandPill.astro';
import DirectoryRoom from '../components/room/DirectoryRoom';
import { getDirectories } from '../lib/catalog';

interface Props {
  title: string;
  description?: string;
  withRoom?: boolean;
}

const { title, description = 'Tools and libraries for digital creatives.', withRoom = false } = Astro.props;
const directories = await getDirectories();
const pageTitle = title === 'Directory' ? 'DIRECTORY — CALL SAL' : `${title} — DIRECTORY`;
---

<!doctype html>
<html lang="en" class:list={[{ 'has-room': withRoom }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="application-name" content="CALL SAL Directory" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <style is:inline>
      html, body { background: #fff; margin: 0; }
      #boot-loader {
        position: fixed; inset: 0; z-index: 100000;
        display: flex; align-items: center; justify-content: center;
        pointer-events: none;
      }
      .boot-scrim {
        position: absolute; inset: 0;
        background: #fff;
        transition: opacity 0.55s ease;
      }
      #boot-loader.is-ack .boot-scrim {
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      #boot-loader.is-ack .boot-pill {
        animation: boot-strobe 0.42s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }
      @keyframes boot-strobe {
        0% { transform: scale(1); filter: brightness(1); box-shadow: 0 0 0 rgba(204,255,0,0); opacity: 1; }
        28% { transform: scale(1.05); filter: brightness(1.28); box-shadow: 0 0 22px rgba(204,255,0,0.55); opacity: 1; }
        100% { transform: scale(1); filter: brightness(1); box-shadow: 0 0 0 rgba(204,255,0,0); opacity: 0; }
      }
      .boot-pill {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        overflow: hidden;
        background: #f3f3f3;
        color: #000;
        font-family: Syne, ui-sans-serif, system-ui, sans-serif;
        font-weight: 800;
        font-size: 14px;
        letter-spacing: -0.025em;
        text-transform: uppercase;
        padding: 0.375rem 0.75rem 0.375rem 0.625rem;
        border-radius: 9999px;
        line-height: 1;
        will-change: transform, opacity, filter;
      }
      .boot-pill-fill {
        position: absolute;
        left: 0; right: 0; bottom: 0;
        height: 0%;
        background: #CCFF00;
        z-index: 0;
        animation: boot-fill 1.15s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }
      @keyframes boot-fill {
        from { height: 0%; }
        to { height: 88%; }
      }
      .boot-pill-inner {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .boot-pill svg { display: block; flex-shrink: 0; }
      @media (prefers-reduced-motion: reduce) {
        .boot-pill-fill { height: 100% !important; animation: none; }
        #boot-loader.is-ack .boot-pill { animation: none; opacity: 0; }
      }
    </style>
  </head>
  <body class="noise-overlay">
    <div id="boot-loader" aria-hidden="true">
      <div class="boot-scrim"></div>
      <div class="boot-pill" id="boot-pill">
        <span class="boot-pill-fill" id="boot-pill-fill"></span>
        <span class="boot-pill-inner">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <path d="M3 8h18"></path>
            <path d="M12 8v12"></path>
            <path d="M3 14h18"></path>
          </svg>
          <span>DIRECTORY</span>
        </span>
      </div>
    </div>

    <svg style="position:absolute;width:0;height:0;pointer-events:none" aria-hidden="true">
      <defs>
        <filter id="glass-displacement">
          <feTurbulence type="fractalNoise" baseFrequency="0.01" numOctaves="3" result="noise"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="8" xChannelSelector="R" yChannelSelector="G"/>
        </filter>
      </defs>
    </svg>

    {withRoom && <DirectoryRoom client:load />}

    <div class="stage-scroll sleek-scroll" id="stage-scroll">
      {withRoom && (
        <section class="hero-stage" id="hero-stage" aria-label="CALL SAL room">
          <div class="scroll-hint intro-ui">
            <span>Scroll the index</span>
            <div class="scroll-mouse" aria-hidden="true"><div class="scroll-dot"></div></div>
          </div>
        </section>
      )}

      <div class="app" id="directory-stage">
        <header class:list={['app-chrome', 'intro-ui']}>
          <BrandPill />
          <p class="est" data-est>
            <span>EST</span>
            <span class="est-year" data-est-year>MMXXVI</span>
            <span>© CALL SAL .</span>
          </p>
          <button type="button" class="menu-btn" data-menu aria-controls="sidebar" aria-expanded="false">
            Index
          </button>
        </header>

        <div class="app-body">
          <Sidebar directories={directories} currentPath={Astro.url.pathname} />
          <div class="scrim" data-scrim hidden></div>
          <div class="viewport sleek-scroll" data-viewport>
            <main data-main>
              <slot />
            </main>
            <footer class="page-foot">
              <span class="est" data-est-foot>
                <span>EST</span>
                <span class="est-year" data-est-year-foot>MMXXVI</span>
                <span>© CALL SAL .</span>
              </span>
              <span>© 2026 CALLSAL</span>
            </footer>
          </div>
        </div>
      </div>
    </div>

    <script define:vars={{ withRoom }}>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let dismissed = false;
      function finishBoot() {
        document.getElementById('boot-loader')?.remove();
      }
      function ackAndFade() {
        const loader = document.getElementById('boot-loader');
        const fill = document.getElementById('boot-pill-fill');
        if (fill) {
          fill.style.animation = 'none';
          fill.style.height = '100%';
        }
        window.dispatchEvent(new Event('callsal:boot-hidden'));
        window.dispatchEvent(new Event('callsal:ready'));
        if (!loader) return;
        if (reduceMotion) {
          finishBoot();
          return;
        }
        loader.classList.add('is-ack');
        window.setTimeout(finishBoot, 420);
      }
      function startBootOut() {
        if (dismissed) return;
        dismissed = true;
        ackAndFade();
      }
      function revealUiFallback() {
        if (document.documentElement.classList.contains('intro-done')) return;
        document.documentElement.classList.add('intro-done');
        window.dispatchEvent(new Event('callsal:intro-complete'));
      }
      const fontsReady = document.fonts?.ready?.catch(() => undefined) ?? Promise.resolve();
      const minPause = new Promise((resolve) => window.setTimeout(resolve, 700));
      Promise.all([fontsReady, minPause]).then(startBootOut);
      window.setTimeout(startBootOut, 2200);
      window.setTimeout(revealUiFallback, 4500);
      if (!withRoom) {
        document.documentElement.classList.add('intro-done');
      }

      const menu = document.querySelector('[data-menu]');
      const scrim = document.querySelector('[data-scrim]');
      const sidebar = document.getElementById('sidebar');
      const viewport = document.querySelector('[data-viewport]');
      const main = document.querySelector('[data-main]');
      const est = document.querySelector('[data-est]');
      const estYear = document.querySelector('[data-est-year]');
      const estFoot = document.querySelector('[data-est-foot]');
      const estYearFoot = document.querySelector('[data-est-year-foot]');

      function setOpen(open) {
        document.body.classList.toggle('drawer-open', open);
        menu?.setAttribute('aria-expanded', String(open));
        if (scrim) scrim.hidden = !open;
      }

      menu?.addEventListener('click', () => {
        setOpen(!document.body.classList.contains('drawer-open'));
      });
      scrim?.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false);
      });

      function bindEst(el, yearEl) {
        el?.addEventListener('mouseenter', () => {
          if (yearEl) yearEl.textContent = '2026';
        });
        el?.addEventListener('mouseleave', () => {
          if (yearEl) yearEl.textContent = 'MMXXVI';
        });
      }
      bindEst(est, estYear);
      bindEst(estFoot, estYearFoot);

      function normalize(path) {
        try {
          const url = new URL(path, location.origin);
          let p = url.pathname;
          if (p.length > 1) p = p.replace(/\/$/, '');
          return p || '/';
        } catch {
          return path;
        }
      }

      const cache = new Map();
      const scrollMap = new Map();
      let navToken = 0;

      if (main) {
        cache.set(normalize(location.pathname), { html: main.innerHTML, title: document.title });
      }

      function updateSidebar(path) {
        const listing = path.match(/\/directory\/([^/]+)/)?.[1] ?? '';
        const category = path.match(/\/category\/([^/]+)/)?.[1] ?? '';

        document.querySelectorAll('[data-listing]').forEach((el) => {
          const href = el.getAttribute('href') ?? '';
          const slug = href.match(/\/directory\/([^/]+)/)?.[1] ?? '';
          if (listing && slug === listing) el.setAttribute('aria-current', 'page');
          else el.removeAttribute('aria-current');
        });

        document.querySelectorAll('[data-category]').forEach((el) => {
          const slug = el.dataset.category ?? '';
          const isCat = slug === category;
          const hasListing = [...el.querySelectorAll('[data-listing]')].some(
            (a) => a.getAttribute('aria-current') === 'page',
          );
          el.classList.toggle('is-active', isCat);
          if (isCat || hasListing) el.open = true;
        });
      }

      async function load(path) {
        const key = normalize(path);
        const hit = cache.get(key);
        if (hit) return hit;
        const res = await fetch(path, { headers: { Accept: 'text/html' } });
        const text = await res.text();
        const doc = new DOMParser().parseFromString(text, 'text/html');
        const html = doc.querySelector('[data-main]')?.innerHTML ?? '';
        const title = doc.title;
        const payload = { html, title };
        cache.set(key, payload);
        return payload;
      }

      function apply(payload, path) {
        if (!main || !viewport) return;
        main.innerHTML = payload.html;
        document.title = payload.title;
        const key = normalize(path);
        viewport.scrollTop = scrollMap.get(key) ?? 0;
        updateSidebar(path);
      }

      async function go(path, push) {
        if (!main || !viewport) return;
        const token = ++navToken;
        scrollMap.set(normalize(location.pathname), viewport.scrollTop);

        const nextUrl = new URL(path, location.origin);
        if (push && normalize(nextUrl.pathname) !== normalize(location.pathname)) {
          history.pushState({}, '', nextUrl.pathname + nextUrl.search);
        }

        const payload = await load(nextUrl.pathname + nextUrl.search);
        if (token !== navToken) return;

        const run = () => apply(payload, nextUrl.pathname);

        if (!reduceMotion && 'startViewTransition' in document) {
          const vt = document.startViewTransition(run);
          try {
            await vt.finished;
          } catch {
            /* interrupted */
          }
        } else if (!reduceMotion) {
          main.classList.add('is-leave');
          await new Promise((resolve) => window.setTimeout(resolve, 120));
          if (token !== navToken) return;
          run();
          main.classList.remove('is-leave');
        } else {
          run();
        }

        setOpen(false);
      }

      document.addEventListener('click', (event) => {
        const target = event.target;
        const link = target?.closest?.('a');
        if (!link || !(link instanceof HTMLAnchorElement)) return;
        if (event.defaultPrevented) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (link.target === '_blank' || link.hasAttribute('download')) return;
        const url = new URL(link.href, location.origin);
        if (url.origin !== location.origin) return;
        if (/\.[a-z0-9]+$/i.test(url.pathname)) return;
        event.preventDefault();
        void go(url.pathname + url.search, true);
      });

      window.addEventListener('popstate', () => {
        void go(location.pathname + location.search, false);
      });

      if (withRoom) {
        const stage = document.getElementById('stage-scroll');
        const hero = document.getElementById('hero-stage');
        if (stage && hero) {
          let snapping = false;
          const snapTo = (top) => {
            snapping = true;
            stage.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
            window.setTimeout(() => { snapping = false; }, 800);
          };
          window.addEventListener('wheel', (event) => {
            const heroH = hero.offsetHeight;
            const atHero = stage.scrollTop < heroH * 0.55;
            const atDirTop = stage.scrollTop >= heroH * 0.55 && stage.scrollTop < heroH + 40;
            if (snapping) {
              event.preventDefault();
              return;
            }
            if (atHero && event.deltaY > 12) {
              event.preventDefault();
              snapTo(heroH);
            } else if (atDirTop && event.deltaY < -12) {
              event.preventDefault();
              snapTo(0);
            }
          }, { passive: false });
        }
      }
    </script>
  </body>
</html>
