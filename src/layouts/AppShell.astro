---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import BrandPill from '../components/BrandPill.astro';
import { getDirectories } from '../lib/catalog';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Tools and libraries for digital creatives.' } = Astro.props;
const directories = await getDirectories();
const pageTitle = title === 'Directory' ? 'Directory — CALL SAL' : `${title} — Directory`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <style is:inline>
      #boot-loader {
        position: fixed; inset: 0; z-index: 100000;
        display: flex; align-items: center; justify-content: center;
        pointer-events: none;
      }
      .boot-scrim {
        position: absolute; inset: 0;
        background: #fff;
        transition: opacity 0.55s ease;
      }
      #boot-loader.is-ack .boot-scrim {
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      #boot-loader.is-ack .boot-pill {
        animation: boot-strobe 0.42s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }
      @keyframes boot-strobe {
        0% { transform: scale(1); filter: brightness(1); box-shadow: 0 0 0 rgba(204,255,0,0); opacity: 1; }
        28% { transform: scale(1.05); filter: brightness(1.28); box-shadow: 0 0 22px rgba(204,255,0,0.55); opacity: 1; }
        100% { transform: scale(1); filter: brightness(1); box-shadow: 0 0 0 rgba(204,255,0,0); opacity: 0; }
      }
      .boot-pill {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        overflow: hidden;
        background: #f3f3f3;
        color: #000;
        font-family: Syne, ui-sans-serif, system-ui, sans-serif;
        font-weight: 800;
        font-size: 14px;
        letter-spacing: -0.025em;
        text-transform: uppercase;
        padding: 0.375rem 0.75rem 0.375rem 0.625rem;
        border-radius: 9999px;
        line-height: 1;
        will-change: transform, opacity, filter;
      }
      .boot-pill-fill {
        position: absolute;
        left: 0; right: 0; bottom: 0;
        height: 0%;
        background: #CCFF00;
        z-index: 0;
        animation: boot-fill 1.15s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }
      @keyframes boot-fill {
        from { height: 0%; }
        to { height: 88%; }
      }
      .boot-pill-inner {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .boot-pill svg { display: block; flex-shrink: 0; }
      @media (prefers-reduced-motion: reduce) {
        .boot-pill-fill { height: 100% !important; animation: none; }
        #boot-loader.is-ack .boot-pill { animation: none; opacity: 0; }
      }
    </style>
  </head>
  <body>
    <div id="boot-loader" aria-hidden="true">
      <div class="boot-scrim"></div>
      <div class="boot-pill" id="boot-pill">
        <span class="boot-pill-fill" id="boot-pill-fill"></span>
        <span class="boot-pill-inner">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 9h18"></path>
          </svg>
          <span>Directory</span>
        </span>
      </div>
    </div>

    <div class="app">
      <header class="app-chrome">
        <BrandPill />
        <p class="est" data-est>
          <span>EST</span>
          <span class="est-year" data-est-year>MMXXVI</span>
          <span>© CALL SAL</span>
        </p>
        <button type="button" class="menu-btn" data-menu aria-controls="sidebar" aria-expanded="false">
          Index
        </button>
      </header>

      <div class="app-body">
        <Sidebar directories={directories} currentPath={Astro.url.pathname} />
        <div class="scrim" data-scrim hidden></div>
        <div class="viewport sleek-scroll" data-viewport>
          <main data-main>
            <slot />
          </main>
          <footer class="page-foot">© 2026 CALLSAL</footer>
        </div>
      </div>
    </div>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let dismissed = false;
      function finishBoot() {
        document.getElementById('boot-loader')?.remove();
      }
      function ackAndFade() {
        const loader = document.getElementById('boot-loader');
        const fill = document.getElementById('boot-pill-fill');
        if (fill) {
          fill.style.animation = 'none';
          fill.style.height = '100%';
        }
        if (!loader) return;
        if (reduceMotion) {
          finishBoot();
          return;
        }
        loader.classList.add('is-ack');
        window.setTimeout(finishBoot, 420);
      }
      function startBootOut() {
        if (dismissed) return;
        dismissed = true;
        ackAndFade();
      }
      const fontsReady = document.fonts?.ready?.catch(() => undefined) ?? Promise.resolve();
      const minPause = new Promise((resolve) => window.setTimeout(resolve, 700));
      Promise.all([fontsReady, minPause]).then(startBootOut);
      window.setTimeout(startBootOut, 2200);

      const menu = document.querySelector('[data-menu]');
      const scrim = document.querySelector('[data-scrim]');
      const viewport = document.querySelector('[data-viewport]');
      const main = document.querySelector('[data-main]');
      const est = document.querySelector('[data-est]');
      const estYear = document.querySelector('[data-est-year]');

      function setOpen(open: boolean) {
        document.body.classList.toggle('drawer-open', open);
        menu?.setAttribute('aria-expanded', String(open));
        if (scrim) (scrim as HTMLElement).hidden = !open;
      }

      menu?.addEventListener('click', () => {
        setOpen(!document.body.classList.contains('drawer-open'));
      });
      scrim?.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false);
      });

      est?.addEventListener('mouseenter', () => {
        if (estYear) estYear.textContent = '2026';
      });
      est?.addEventListener('mouseleave', () => {
        if (estYear) estYear.textContent = 'MMXXVI';
      });

      function normalize(path: string) {
        try {
          const url = new URL(path, location.origin);
          let p = url.pathname;
          if (p.length > 1) p = p.replace(/\/$/, '');
          return p || '/';
        } catch {
          return path;
        }
      }

      const cache = new Map<string, { html: string; title: string }>();
      const scrollMap = new Map<string, number>();
      let navToken = 0;

      if (main) {
        cache.set(normalize(location.pathname), { html: main.innerHTML, title: document.title });
      }

      function updateSidebar(path: string) {
        const listing = path.match(/\/directory\/([^/]+)/)?.[1] ?? '';
        const category = path.match(/\/category\/([^/]+)/)?.[1] ?? '';

        document.querySelectorAll('[data-listing]').forEach((el) => {
          const href = el.getAttribute('href') ?? '';
          const slug = href.match(/\/directory\/([^/]+)/)?.[1] ?? '';
          if (listing && slug === listing) el.setAttribute('aria-current', 'page');
          else el.removeAttribute('aria-current');
        });

        document.querySelectorAll('[data-category]').forEach((el) => {
          const slug = (el as HTMLElement).dataset.category ?? '';
          const isCat = slug === category;
          const hasListing = [...el.querySelectorAll('[data-listing]')].some(
            (a) => a.getAttribute('aria-current') === 'page',
          );
          el.classList.toggle('is-active', isCat);
          if (isCat || hasListing) (el as HTMLDetailsElement).open = true;
        });
      }

      async function load(path: string) {
        const key = normalize(path);
        const hit = cache.get(key);
        if (hit) return hit;
        const res = await fetch(path, { headers: { Accept: 'text/html' } });
        const text = await res.text();
        const doc = new DOMParser().parseFromString(text, 'text/html');
        const html = doc.querySelector('[data-main]')?.innerHTML ?? '';
        const title = doc.title;
        const payload = { html, title };
        cache.set(key, payload);
        return payload;
      }

      function apply(payload: { html: string; title: string }, path: string) {
        if (!main || !viewport) return;
        main.innerHTML = payload.html;
        document.title = payload.title;
        const key = normalize(path);
        viewport.scrollTop = scrollMap.get(key) ?? 0;
        updateSidebar(path);
      }

      async function go(path: string, push: boolean) {
        if (!main || !viewport) return;
        const token = ++navToken;
        scrollMap.set(normalize(location.pathname), viewport.scrollTop);

        const nextUrl = new URL(path, location.origin);
        if (push && normalize(nextUrl.pathname) !== normalize(location.pathname)) {
          history.pushState({}, '', nextUrl.pathname + nextUrl.search);
        }

        const payload = await load(nextUrl.pathname + nextUrl.search);
        if (token !== navToken) return;

        const run = () => apply(payload, nextUrl.pathname);

        if (!reduceMotion && 'startViewTransition' in document) {
          const vt = (document as Document & { startViewTransition: (cb: () => void) => { finished: Promise<void> } }).startViewTransition(run);
          try {
            await vt.finished;
          } catch {
            /* interrupted */
          }
        } else if (!reduceMotion) {
          main.classList.add('is-leave');
          await new Promise((resolve) => window.setTimeout(resolve, 120));
          if (token !== navToken) return;
          run();
          main.classList.remove('is-leave');
        } else {
          run();
        }

        setOpen(false);
      }

      document.addEventListener('click', (event) => {
        const target = event.target as Element | null;
        const link = target?.closest?.('a');
        if (!link || !(link instanceof HTMLAnchorElement)) return;
        if (event.defaultPrevented) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (link.target === '_blank' || link.hasAttribute('download')) return;
        const url = new URL(link.href, location.origin);
        if (url.origin !== location.origin) return;
        if (/\.[a-z0-9]+$/i.test(url.pathname)) return;
        event.preventDefault();
        void go(url.pathname + url.search, true);
      });

      window.addEventListener('popstate', () => {
        void go(location.pathname + location.search, false);
      });
    </script>
  </body>
</html>
