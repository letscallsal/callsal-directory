---
import AppShell from '../../layouts/AppShell.astro';
import ShopCard from '../../components/ShopCard.astro';
import { TYPE_META, getShops, byType, typeLabel, type TypeSlug } from '../../lib/shops';

export function getStaticPaths() {
  return TYPE_META.map((item) => ({
    params: { slug: item.slug },
  }));
}

const slug = Astro.params.slug as TypeSlug;
const all = await getShops();
const shops = byType(all, slug);
const label = typeLabel(slug);
---

<AppShell title={label} description={`Live ${label.toLowerCase()} listings from Google Business, anywhere on earth.`}>
  <header class="page-head">
    <p class="page-kicker">FOR AGENCIES AND FREELANCERS</p>
    <h1 class="page-title">{label}</h1>
    <p class="page-tag">Pick a city in the menu to load live {label.toLowerCase()} listings from Google Business.</p>
  </header>

  {shops.length > 0 ? (
    <div class="grid" data-shop-grid>
      {shops.map((shop) => (
        <ShopCard shop={shop} />
      ))}
    </div>
  ) : (
    <p class="empty">Nothing listed here yet. Open a city from the menu.</p>
  )}
  <div class="rows" data-live-rows hidden></div>
</AppShell>
