---
import AppShell from '../layouts/AppShell.astro';
import milton from '../data/milton-leads.json';
import { typeLabel } from '../lib/shops';

const PREVIEW_COLS = [
  { label: 'NEW', n: 4 },
  { label: 'CONTACTED', n: 3 },
  { label: 'RESPONDED', n: 3 },
  { label: 'MEETING', n: 2 },
  { label: 'PROPOSAL', n: 2 },
  { label: 'WON', n: 1 },
];

const previewShops = (milton.shops as Array<{
  name: string;
  city?: string;
  phone?: string;
  category?: string;
}>).filter((shop) => shop.phone);

let cursor = 0;
const previewCols = PREVIEW_COLS.map((col) => {
  const items = previewShops.slice(cursor, cursor + col.n);
  cursor += col.n;
  return { ...col, items };
});
---

<AppShell title="Leads" description="Search a city of Google Business listings, tap plus, and call from a board.">
  <div class="leads-sale" data-leads-guest>
    <header class="page-head">
      <p class="page-kicker">FOR AGENCIES AND FREELANCERS</p>
      <h1 class="page-title">Leads</h1>
      <p class="page-tag">Search a city. Tap plus. Call the board. Listings are live Google Business profiles — name and phone, ready to dial.</p>
    </header>

    <div class="kanban kanban-preview" aria-hidden="true">
      {previewCols.map((col) => (
        <section class="kanban-col">
          <h2>{col.label} <span>{col.items.length}</span></h2>
          {col.items.map((shop) => (
            <article class="lead-card">
              <p class="lead-type">{typeLabel(shop.category || '')} · {shop.city || 'Milton'}</p>
              <div class="lead-main">
                <div class="lead-copy">
                  <h3>{shop.name}</h3>
                  <p class="lead-phone">{shop.phone}</p>
                </div>
              </div>
            </article>
          ))}
        </section>
      ))}
    </div>

    <div class="leads-steps">
      <article class="leads-step">
        <p class="leads-step-num">01</p>
        <h2>Plus from Directory</h2>
        <p>Open a city on the map. Tap plus on a listing. It lands in NEW.</p>
      </article>
      <article class="leads-step">
        <p class="leads-step-num">02</p>
        <h2>Work the board</h2>
        <p>Drag across six stages. Name and phone stay on the card so you can call.</p>
      </article>
      <article class="leads-step">
        <p class="leads-step-num">03</p>
        <h2>Import a city</h2>
        <p>Paid fills one city every 24 hours — one niche, or all niches. Free adds one at a time.</p>
      </article>
    </div>

    <div class="leads-plans">
      <article class="leads-plan">
        <p class="page-kicker">Free</p>
        <h2>Free</h2>
        <p>Join, browse Directory, tap plus. Board starts empty and holds 100 leads. No bulk import. No credit card.</p>
        <button type="button" class="btn-glass hover-lift" data-leads-pick="free">JOIN</button>
      </article>
      <article class="leads-plan is-paid">
        <p class="page-kicker">$999 a month</p>
        <h2>Paid</h2>
        <p>No lead cap. Import one city every 24 hours — one niche, or all niches in that city. Your board stays yours. Oracle drafts never send.</p>
        <button type="button" class="btn-primary hover-lift" data-leads-pick="paid">JOIN PAID</button>
      </article>
    </div>
  </div>

  <div class="leads-app" data-leads-app hidden>
    <header class="page-head">
      <p class="page-kicker">FOR AGENCIES AND FREELANCERS</p>
      <h1 class="page-title">Leads</h1>
      <p class="page-tag">Free: plus on a listing, 100 cap. Paid: no cap. Import one city every 24 hours.</p>
    </header>

    <div class="leads-toolbar">
      <p class="leads-usage" data-leads-usage></p>
      <div class="leads-actions">
        <button type="button" class="soft-pill" data-scan-leads>IMPORT CITY</button>
        <button type="button" class="soft-pill" data-ask-oracle>ORACLE</button>
      </div>
    </div>

    <p class="leads-empty" data-leads-empty hidden>
      <span>Board starts empty. Open Directory and tap plus on a listing.</span>
      <a href="/" class="soft-pill">DIRECTORY</a>
    </p>

    <aside class="oracle-panel" data-oracle-panel hidden></aside>

    <div class="kanban" data-leads-board>
      <section class="kanban-col" data-col="New">
        <h2>NEW <span data-col-count="New"></span></h2>
        <div data-col-cards="New"></div>
      </section>
      <section class="kanban-col" data-col="Contacted">
        <h2>CONTACTED <span data-col-count="Contacted"></span></h2>
        <div data-col-cards="Contacted"></div>
      </section>
      <section class="kanban-col" data-col="Responded">
        <h2>RESPONDED <span data-col-count="Responded"></span></h2>
        <div data-col-cards="Responded"></div>
      </section>
      <section class="kanban-col" data-col="Meeting Scheduled">
        <h2>MEETING <span data-col-count="Meeting Scheduled"></span></h2>
        <div data-col-cards="Meeting Scheduled"></div>
      </section>
      <section class="kanban-col" data-col="Proposal Sent">
        <h2>PROPOSAL <span data-col-count="Proposal Sent"></span></h2>
        <div data-col-cards="Proposal Sent"></div>
      </section>
      <section class="kanban-col" data-col="Won">
        <h2>WON <span data-col-count="Won"></span></h2>
        <div data-col-cards="Won"></div>
      </section>
    </div>
  </div>
</AppShell>
