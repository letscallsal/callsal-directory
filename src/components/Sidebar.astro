---
import { TYPE_META, type Shop } from '../lib/shops';

interface Props {
  shops: Shop[];
  currentPath: string;
}

const { shops, currentPath } = Astro.props;
const currentType = currentPath.match(/^\/type\/([^/]+)/)?.[1] ?? '';
const isSaved = currentPath.replace(/\/$/, '') === '/saved';
const isLeads = currentPath.replace(/\/$/, '') === '/leads';

const grouped = TYPE_META.map((item) => ({
  ...item,
  count: shops.filter((shop) => shop.category === item.slug).length,
})).filter((item) => item.count > 0);
---

<aside class="sidebar" id="sidebar" data-sidebar>
  <div class="sidebar-search">
    <label for="directory-search">Search</label>
    <input
      id="directory-search"
      type="search"
      placeholder="Filter shop types"
      autocomplete="off"
      data-search
    />
  </div>

  <nav class="sidebar-index sleek-scroll" aria-label="Index" data-index>
    <a class="sidebar-saved" href="/leads/" data-leads-link aria-current={isLeads ? 'page' : undefined}>Leads</a>
    <a class="sidebar-saved" href="/saved/" data-saved-link aria-current={isSaved ? 'page' : undefined}>Saved</a>
    {grouped.map((item) => (
      <a
        class="sidebar-saved"
        href={`/type/${item.slug}/`}
        data-type={item.slug}
        data-label={item.label}
        aria-current={item.slug === currentType ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</aside>

<script>
  const search = document.querySelector('[data-search]') as HTMLInputElement | null;
  const types = document.querySelectorAll('[data-type]');

  function filterIndex(query: string) {
    const q = query.trim().toLowerCase();
    for (const item of types) {
      const label = ((item as HTMLElement).dataset.label ?? '').toLowerCase();
      (item as HTMLElement).hidden = Boolean(q) && !label.includes(q);
    }
  }

  search?.addEventListener('input', () => filterIndex(search.value));
</script>
