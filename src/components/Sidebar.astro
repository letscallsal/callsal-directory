---
import { TYPE_META, type Shop } from '../lib/shops';
import ShopFilters from './ShopFilters.astro';

interface Props {
  shops: Shop[];
  currentPath: string;
}

const { shops, currentPath } = Astro.props;
const currentType = currentPath.match(/^\/type\/([^/]+)/)?.[1] ?? '';

const grouped = TYPE_META.map((item) => ({
  ...item,
  count: shops.filter((shop) => shop.category === item.slug).length,
})).filter((item) => item.count > 0);

const cities = [...new Set(shops.map((shop) => shop.city))].sort((a, b) => a.localeCompare(b));
---

<aside class="sidebar sleek-scroll" id="sidebar" data-sidebar aria-label="Directory menu">
  <ShopFilters cities={cities} />

  <nav class="sidebar-index" data-index>
    {grouped.map((item) => (
      <a
        class="sidebar-saved"
        href={`/type/${item.slug}/`}
        data-type={item.slug}
        data-label={item.label}
        aria-current={item.slug === currentType ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</aside>
