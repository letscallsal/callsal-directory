---
import type { DirectoryEntry } from '../lib/catalog';
import DirectoryCard from './DirectoryCard.astro';

interface Props {
  title: string;
  entries: DirectoryEntry[];
  href?: string;
}

const { title, entries, href } = Astro.props;
---

{entries.length > 0 && (
  <section class="row" data-carousel>
    <div class="row-head">
      {href ? (
        <h2><a href={href}>{title}</a></h2>
      ) : (
        <h2>{title}</h2>
      )}
      {entries.length > 1 && (
        <div class="row-nav">
          <button type="button" data-prev aria-label={`Previous ${title}`}>‹</button>
          <button type="button" data-next aria-label={`Next ${title}`}>›</button>
        </div>
      )}
    </div>
    <div class="track sleek-scroll" data-track>
      {entries.map((entry) => (
        <DirectoryCard entry={entry} />
      ))}
    </div>
  </section>
)}

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const row of document.querySelectorAll('[data-carousel]')) {
    if (row.dataset.bound === '1') continue;
    row.dataset.bound = '1';

    const track = row.querySelector('[data-track]');
    const prev = row.querySelector('[data-prev]');
    const next = row.querySelector('[data-next]');
    if (!track) continue;

    const step = () => Math.max(track.clientWidth * 0.72, 220);

    prev?.addEventListener('click', () => {
      track.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' });
    });
    next?.addEventListener('click', () => {
      track.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
