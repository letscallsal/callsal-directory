---
import { categoryLabel, pricingLabel, type DirectoryEntry } from '../lib/catalog';

interface Props {
  entry: DirectoryEntry;
}

const { entry } = Astro.props;
const href = `/directory/${entry.slug}/`;
---

<div class="card-wrap" data-card-slug={entry.slug}>
  <a class="card hover-lift" href={href}>
    <img
      class="card-preview"
      src={entry.data.preview}
      alt={`${entry.data.title} website`}
      width="640"
      height="400"
      loading="lazy"
    />
    <span class="card-cat">{categoryLabel(entry.data.category)} · {pricingLabel(entry.data.pricing)}</span>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.tagline}</p>
  </a>
  <button type="button" class="bookmark-btn" data-bookmark={entry.slug} aria-label={`Save ${entry.data.title}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>
</div>

<style is:global>
  .card-wrap {
    flex: 0 0 min(19.5rem, 82vw);
  }

  .card-wrap .card {
    justify-content: flex-start;
    min-height: 0;
    padding: 0 0 1.15rem;
    overflow: hidden;
  }

  .card-preview {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    height: auto;
    object-fit: cover;
    object-position: top center;
    background: #0a0a0a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card-wrap .card-cat {
    margin: 0.95rem 1.15rem 0;
  }

  .card-wrap .card h3 {
    margin: 0.55rem 1.15rem 0.35rem;
  }

  .card-wrap .card p {
    margin: 0 1.15rem;
  }

  .card-wrap .bookmark-btn {
    background: rgba(0, 0, 0, 0.55);
  }
</style>
