---
import { typeLabel, type Shop, listingPhotoSrc, storedHomepagePreview } from '../lib/shops';

interface Props {
  shop: Shop;
}

const { shop } = Astro.props;
const type = typeLabel(shop.category);
const googlePhoto = listingPhotoSrc(shop);
const homepagePhoto = storedHomepagePreview(shop);
const photo = googlePhoto || homepagePhoto;
const fallback = googlePhoto && homepagePhoto ? homepagePhoto : undefined;
const address = shop.verified.address && shop.address ? shop.address : undefined;
const phone = shop.verified.phone && shop.phone ? shop.phone : undefined;
const website = shop.verified.website && shop.website ? shop.website : undefined;
const email = shop.verified.email && shop.email ? shop.email : undefined;
const owner = shop.verified.ownerName && shop.ownerName ? shop.ownerName : undefined;
const ig = shop.verified.socials && shop.socials?.instagram ? shop.socials.instagram : undefined;
const rating = shop.rating ? shop.rating.toFixed(1) : '';
const maps = shop.mapsUrl || '';
const hours = shop.hours?.join(' | ') || '';
const catLine = [type, shop.city, rating ? `${rating}★` : ''].filter(Boolean).join(' · ');
---

<div
  class="card-wrap"
  data-card-slug={shop.slug}
  data-shop-name={shop.name}
  data-shop-city={shop.city}
  data-shop-region={shop.region}
  data-shop-type={shop.category}
  data-shop-type-label={type}
  data-has-email={shop.verified.email ? '1' : '0'}
  data-has-phone={shop.verified.phone ? '1' : '0'}
  data-has-website={shop.verified.website ? '1' : '0'}
  data-shop-address={address}
  data-shop-phone={phone}
  data-shop-website={website}
  data-shop-email={email}
  data-shop-owner={owner}
  data-shop-ig={ig}
  data-shop-photo={photo}
  data-shop-place-id={shop.placeId}
  data-shop-rating={rating}
  data-shop-maps={maps}
  data-shop-hours={hours}
>
  <div class="card hover-lift">
    {photo ? (
      <img
        class="card-preview"
        src={photo}
        data-photo-fallback={fallback}
        alt={`${shop.name} listing photo`}
        width="640"
        height="400"
        loading="lazy"
      />
    ) : (
      <div class="card-preview card-preview-missing" aria-label="Photo missing">
        <span>Photo missing</span>
      </div>
    )}
    <span class="card-cat">{catLine}</span>
    <h3>{shop.name}</h3>
    <p>{shop.city}, {shop.region}</p>
  </div>
  <button
    type="button"
    class="add-lead-btn"
    data-add-lead={shop.slug}
    aria-label={`Add ${shop.name} to leads`}
    aria-pressed="false"
  >
    <svg class="add-lead-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
      <path d="M12 5v14"></path>
      <path d="M5 12h14"></path>
    </svg>
    <svg class="add-lead-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 12 4 4 8-8"></path>
    </svg>
  </button>
</div>

<script>
  if (!(window as Window & { __dirShopPhotoBound?: boolean }).__dirShopPhotoBound) {
    (window as Window & { __dirShopPhotoBound?: boolean }).__dirShopPhotoBound = true;
    document.addEventListener(
      'error',
      (event) => {
        const img = event.target;
        if (!(img instanceof HTMLImageElement) || !img.classList.contains('card-preview')) return;
        if (!img.closest('[data-shop-type], .shop-info-media')) return;
        const next = img.getAttribute('data-photo-fallback');
        if (next) {
          img.removeAttribute('data-photo-fallback');
          img.src = next;
          return;
        }
        const missing = document.createElement('div');
        missing.className = img.className.replace(/\bcard-preview\b/, 'card-preview card-preview-missing').trim();
        if (!missing.classList.contains('card-preview-missing')) missing.classList.add('card-preview-missing');
        missing.setAttribute('aria-label', 'Photo missing');
        missing.innerHTML = '<span>Photo missing</span>';
        img.replaceWith(missing);
      },
      true,
    );
  }
</script>

<style is:global>
  .card-wrap {
    flex: 0 0 min(19.5rem, 82vw);
  }

  .card-wrap .card {
    justify-content: flex-start;
    min-height: 0;
    padding: 0 0 1.15rem;
    overflow: hidden;
  }

  .card-wrap[data-shop-type] .card {
    cursor: pointer;
  }

  .card-preview {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    height: auto;
    object-fit: cover;
    object-position: top center;
    background: #0a0a0a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card-preview-missing {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8a8a8a;
    font-family: Syne, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .card-wrap .card-cat {
    margin: 0.95rem 1.15rem 0;
  }

  .card-wrap .card h3 {
    margin: 0.55rem 1.15rem 0.35rem;
  }

  .card-wrap .card p {
    margin: 0 1.15rem;
  }
</style>
