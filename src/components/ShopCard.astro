---
import { typeLabel, type Shop } from '../lib/shops';

interface Props {
  shop: Shop;
}

const { shop } = Astro.props;
const type = typeLabel(shop.category);
const phone = shop.phone || undefined;
const website = shop.website || undefined;
const email = shop.email || undefined;
const owner = shop.ownerName || undefined;
const igRaw = shop.socials?.instagram || '';
const igHandle = igRaw.replace(/^https?:\/\/(www\.)?instagram\.com\//i, '').replace(/^@/, '').split(/[/?#]/)[0];
const igHref = igHandle ? `https://www.instagram.com/${igHandle}` : '';
const igTip = igHandle ? `@${igHandle}` : '';
const address = shop.address || undefined;
const rating = shop.rating ? shop.rating.toFixed(1) : '';
const maps = shop.mapsUrl || '';
const hours = shop.hours?.join(' | ') || '';
const catLine = [type, shop.city, rating ? `${rating}★` : ''].filter(Boolean).join(' · ');
const webHref = website ? (/^https?:\/\//i.test(website) ? website : `https://${website.replace(/^\/+/, '')}`) : '';
---

<div
  class="card-wrap"
  data-card-slug={shop.slug}
  data-shop-name={shop.name}
  data-shop-city={shop.city}
  data-shop-region={shop.region}
  data-shop-type={shop.category}
  data-shop-type-label={type}
  data-has-email={email ? '1' : '0'}
  data-has-phone={phone ? '1' : '0'}
  data-has-website={website ? '1' : '0'}
  data-shop-address={address}
  data-shop-phone={phone}
  data-shop-website={website}
  data-shop-email={email}
  data-shop-owner={owner}
  data-shop-ig={igRaw}
  data-shop-place-id={shop.placeId}
  data-shop-rating={rating}
  data-shop-maps={maps}
  data-shop-hours={hours}
>
  <div class="card hover-lift">
    <span class="card-cat">{catLine}</span>
    <h3 dir="auto">{shop.name}</h3>
    {phone ? (
      <p class="lead-phone" data-lead-act="copy" data-copy={phone} data-tip={phone}>{phone}</p>
    ) : (
      <p class="lead-phone lead-phone-empty">No phone</p>
    )}
    <div class="lead-acts">
      {webHref && (
        <button type="button" class="lead-act" draggable="false" data-lead-act="web" data-href={webHref} data-tip={website} aria-label={website}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18"/><path d="M12 3a14 14 0 0 0 0 18"/></svg>
        </button>
      )}
      {phone && (
        <button type="button" class="lead-act" draggable="false" data-lead-act="copy" data-copy={phone} data-tip={phone} aria-label={phone}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h3l1.2 4.2-2 1.2a12 12 0 0 0 5.4 5.4l1.2-2H21l.2 3.2A16 16 0 0 1 7 3z"/></svg>
        </button>
      )}
      {email && (
        <button type="button" class="lead-act" draggable="false" data-lead-act="copy" data-copy={email} data-tip={email} aria-label={email}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 7 9-7"/></svg>
        </button>
      )}
      {igHref && (
        <button type="button" class="lead-act" draggable="false" data-lead-act="ig" data-href={igHref} data-tip={igTip} aria-label={igTip}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.6"/><circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none"/></svg>
        </button>
      )}
    </div>
  </div>
  <button
    type="button"
    class="add-lead-btn"
    data-add-lead={shop.slug}
    aria-label={`Add ${shop.name} to leads`}
    aria-pressed="false"
  >
    <svg class="add-lead-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
      <path d="M12 5v14"></path>
      <path d="M5 12h14"></path>
    </svg>
    <svg class="add-lead-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 12 4 4 8-8"></path>
    </svg>
  </button>
</div>

<style is:global>
  .card-wrap[data-shop-type] {
    flex: 0 0 min(16.25rem, 86vw);
  }

  .card-wrap[data-shop-type] .card {
    justify-content: flex-start;
    min-height: 0;
    padding: 0.9rem 1rem 0.85rem;
    overflow: visible;
    border-left: 3px solid #CCFF00;
  }

  .card-wrap[data-shop-type] .card-cat {
    margin: 0 2.1rem 0 0;
  }

  .card-wrap[data-shop-type] .card h3 {
    margin: 0.4rem 2.1rem 0 0;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .card-wrap[data-shop-type] .lead-phone {
    margin: 0.4rem 0 0;
  }

  .lead-phone-empty {
    color: #8a8a8a;
    font-size: 0.78rem;
  }
</style>
