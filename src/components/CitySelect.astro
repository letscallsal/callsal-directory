---
import '../styles/city-select.css';

interface Props {
  cities: string[];
}

const { cities } = Astro.props;
---

<div class="guest-city" data-guest-city>
  <div class="guest-city-row">
    <label class="guest-city-field">
      <span class="guest-city-sr">Search city</span>
      <svg class="guest-city-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="M16 16l5 5"></path>
      </svg>
      <input
        type="search"
        data-city-input
        placeholder="SEARCH CITY"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="guest-city-list"
        aria-autocomplete="list"
      />
    </label>
    <button type="button" class="guest-city-go" data-city-apply>SELECT CITY</button>
  </div>

  <ul class="guest-city-list" id="guest-city-list" data-city-list role="listbox">
    <li>
      <button type="button" class="guest-city-opt is-on" data-city-pick="" role="option">All cities</button>
    </li>
    {cities.map((city) => (
      <li>
        <button type="button" class="guest-city-opt" data-city-pick={city} role="option">{city}</button>
      </li>
    ))}
  </ul>

  <p class="guest-city-hint">These are the Ontario cities we already have shops for.</p>
  <p class="guest-city-miss" data-city-miss hidden>We only have shops in the listed cities.</p>
</div>
