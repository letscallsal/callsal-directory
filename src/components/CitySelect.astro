---
import '../styles/city-select.css';
---

<div class="guest-city" data-guest-city>
  <div class="guest-city-combo">
    <label class="guest-city-field">
      <span class="guest-city-sr">Search a place</span>
      <svg class="guest-city-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="M16 16l5 5"></path>
      </svg>
      <input
        type="search"
        data-city-input
        placeholder="SEARCH A PLACE"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="guest-city-list"
        aria-autocomplete="list"
      />
    </label>

    <ul class="guest-city-list" id="guest-city-list" data-city-list role="listbox" hidden></ul>
  </div>

  <p class="guest-city-hint">City, street, or address. Anywhere on earth.</p>
  <p class="guest-city-status" data-city-status hidden></p>
  <p class="guest-city-miss" data-city-miss hidden>No match. Try a city or a street.</p>
</div>
